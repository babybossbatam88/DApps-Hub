# ==========================================================================
# LP COMMAND CENTER — environment template
# Copy to `.env` and fill in. NEVER commit a populated .env.
# ==========================================================================

# --- Runtime mode -------------------------------------------------------
# "demo" renders clearly-labelled development fixtures.
# "live" refuses to render any fabricated number.
NEXT_PUBLIC_APP_MODE=demo

# --- Database -----------------------------------------------------------
# PostgreSQL connection string (pooled connection for the app).
DATABASE_URL="postgresql://user:password@localhost:5432/lp_command_center?schema=public"
# Direct (unpooled) connection. Prisma Migrate uses this one: poolers such as
# PgBouncer do not support the advisory locks and session DDL that migrations need.
DIRECT_URL="postgresql://user:password@localhost:5432/lp_command_center?schema=public"

# --- Base Mainnet RPC (chain id 8453) -----------------------------------
# Comma-separated list. The client fails over left-to-right and load balances.
# A dedicated provider key (Alchemy/Infura/QuickNode/Ankr) is strongly
# recommended: public endpoints rate-limit position discovery.
BASE_RPC_URLS="https://mainnet.base.org"
# Optional: block explorer API key, used later for tx history enrichment.
BASESCAN_API_KEY=

# --- Binance (Phase 10/11) ----------------------------------------------
# Public market data needs no credentials.
BINANCE_API_BASE_URL="https://api.binance.com"
# Authenticated READ-ONLY account access is optional and off by default.
# Credentials are encrypted at rest with BINANCE_ENCRYPTION_KEY and are NEVER
# sent to the browser. The API key MUST have withdrawals disabled.
BINANCE_ENABLE_ACCOUNT_READ=false
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
BINANCE_ENCRYPTION_KEY=

# --- Feature flags ------------------------------------------------------
# Trading is out of scope for V1 and must stay false.
FEATURE_BINANCE_TRADING=false
# Background snapshot worker (Phase 8).
FEATURE_BACKGROUND_SYNC=false

# --- Jobs ---------------------------------------------------------------
# Shared secret required by /api/jobs/* so cron endpoints are not open to all.
CRON_SECRET=

# --- Auth (Phase 13) ----------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
